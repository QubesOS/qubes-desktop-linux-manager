#: qubes_config/global_config.glade:88
msgid "Qube"
msgstr "Qube"

#: qubes_config/global_config.glade:110
msgid "Select qube:"
msgstr "בחירת qube:"

#: qubes_config/global_config.glade:159
msgid "Select a qube to be able to select device types to block."
msgstr "יש לבחור qube כדי לבחור סוגי התקנים לחסימה."

#: qubes_config/global_config.glade:183
msgid "Deny device attachment"
msgstr "מניעת חיבור התקנים"

#: qubes_config/global_config.glade:200
msgid ""
"You will not be able to manually attach any of the selected device types to "
"this qube. This does <b>NOT</b> apply to automatic attachments."
msgstr ""
"לא תוכל לחבר ידנית ל-qube הזה אף אחד מסוגי ההתקנים שנבחרו. זה <b>לא</b> חל "
"על חיבורים אוטומטיים."

#: qubes_config/global_config.glade:349 qubes_config/global_config.glade:9876
msgid "Device"
msgstr "התקן"

#: qubes_config/global_config.glade:371 qubes_config/global_config.glade:9898
#: qui/devices/AttachConfirmationWindow.glade:258
msgid "Device:"
msgstr "התקן:"

#: qubes_config/global_config.glade:431 qubes_config/global_config.glade:9976
msgid ""
"This device is not currently connected. The assignment cannot be modified."
msgstr "ההתקן הזה לא מחובר כרגע. אי אפשר לשנות את ההקצאה."

#: qubes_config/global_config.glade:457
msgid "Apply rule to devices matching:"
msgstr "החלת הכלל על התקנים שתואמים ל:"

#: qubes_config/global_config.glade:475
msgid "Backend qube:"
msgstr "‏qube צד אחורי:"

#: qubes_config/global_config.glade:480
msgid ""
"Backend qube cannot be changed dynamically. Select a device from desired "
"backend qube."
msgstr ""
"אי אפשר לשנות את ה-qube של הצד האחורי באופן דינמי. יש לבחור התקן מה-qube "
"הרצוי."

#: qubes_config/global_config.glade:509
#: qubes_config/global_config/device_attachments.py:159
msgid "Device class: "
msgstr "סוג התקן: "

#: qubes_config/global_config.glade:514
msgid ""
"Device class cannot be set independently. Select a device from desired "
"class."
msgstr "אי אפשר להגדיר את סוג ההתקן בנפרד. יש לבחור התקן מהסוג הרצוי."

#: qubes_config/global_config.glade:533 qubes_config/global_config.glade:1287
#: qubes_config/global_config.glade:9208 qubes_config/new_qube.glade:1909
msgid " "
msgstr " "

#: qubes_config/global_config.glade:558
msgid "Device identity:"
msgstr "זהות ההתקן:"

#: qubes_config/global_config.glade:606
#: qubes_config/global_config/device_attachments.py:221
msgid "Port: "
msgstr "יציאה: "

#: qubes_config/global_config.glade:649
msgid ""
"<b>Port</b> refers to the port this device is currently plugged in. If you "
"select matching the port, the device <b>must</b> be plugged into this port "
"to be automatically attached. If you select port and not device identity, "
"all devices plugged into this port will be automatically attached."
msgstr ""
"<b>יציאה</b> היא היציאה שאליה ההתקן מחובר כרגע. אם בוחרים התאמה לפי יציאה, "
"ההתקן <b>חייב</b> להיות מחובר ליציאה הזו כדי שיחובר אוטומטית. אם בוחרים "
"יציאה בלי זהות ההתקן, כל ההתקנים שמחוברים ליציאה הזו יחוברו אוטומטית."

#: qubes_config/global_config.glade:668
msgid "Action"
msgstr "פעולה"

#: qubes_config/global_config.glade:685
msgid "Select what happens when the device becomes available."
msgstr "יש לבחור מה יקרה כשההתקן יהיה זמין."

#: qubes_config/global_config.glade:715
msgid "Automatically attach the device to the selected qube"
msgstr "לחבר את ההתקן אוטומטית ל-qube שנבחר"

#: qubes_config/global_config.glade:733
msgid ""
"If multiple qubes are selected and running when the device is connected, you"
" will be asked to choose one of them."
msgstr "אם נבחרו כמה qubes והם פועלים כשההתקן מתחבר, תתבקש לבחור אחד מהם."

#: qubes_config/global_config.glade:757
msgid "Ask to attach to one of the selected qubes"
msgstr "לשאול לאיזה מה-qubes שנבחרו לחבר"

#: qubes_config/global_config.glade:775
msgid "Read-only (only for block devices)"
msgstr "קריאה בלבד (רק להתקני בלוק)"

#: qubes_config/global_config.glade:793 qubes_config/global_config.glade:10123
msgid "Qubes"
msgstr "Qubes"

#: qubes_config/global_config.glade:882 qubes_config/global_config.glade:2383
#: qubes_config/global_config.glade:2681 qubes_config/global_config.glade:2916
#: qubes_config/global_config.glade:10212
msgid "Add qube"
msgstr "הוספת qube"

#: qubes_config/global_config.glade:923 qubes_config/global_config.glade:10253
msgid "A device cannot be attached to its own backend qube."
msgstr "אי אפשר לחבר התקן ל-qube הצד האחורי שלו."

#: qubes_config/global_config.glade:967
msgid "Qubes OS Global Config"
msgstr "הגדרות כלליות של Qubes OS"

#: qubes_config/global_config.glade:1006
msgid "Default and service qubes"
msgstr "‏qubes ברירת מחדל ו-qubes שירות"

#: qubes_config/global_config.glade:1022
msgid ""
"Select the qubes that are used by default and that provide basic services."
msgstr "יש לבחור את ה-qubes שמשמשים כברירת מחדל ושמספקים שירותים בסיסיים."

#: qubes_config/global_config.glade:1043
msgid "Clock qube:"
msgstr "‏qube שעון:"

#: qubes_config/global_config.glade:1059
msgid "This qube sets the time in the system."
msgstr "ה-qube הזה קובע את השעה במערכת."

#: qubes_config/global_config.glade:1081
msgid "Window Management"
msgstr "ניהול חלונות"

#: qubes_config/global_config.glade:1097
msgid "Fullscreen mode:"
msgstr "מצב מסך מלא:"

#: qubes_config/global_config.glade:1226
msgid "Memory Balancing"
msgstr "איזון זיכרון"

#: qubes_config/global_config.glade:1242
msgid ""
"These control the default memory settings for all qubes except those with "
"connected PCI devices."
msgstr ""
"ההגדרות האלה קובעות את הגדרות הזיכרון שבברירת המחדל לכל ה-qubes, חוץ מ-qubes"
" עם התקני PCI מחוברים."

#: qubes_config/global_config.glade:1259
msgid "Linux Kernel"
msgstr "ליבת Linux"

#: qubes_config/global_config.glade:1299
msgid ""
"This is the default kernel for Linux qubes. You can select a different "
"kernel for an individual qube in that qube's settings."
msgstr ""
"זו ליבת ברירת המחדל ל-qubes של Linux. אפשר לבחור ליבה אחרת ל-qube מסוים "
"בהגדרות של אותו qube."

#: qubes_config/global_config.glade:1321
msgid "Default net qube:"
msgstr "‏qube רשת ברירת מחדל:"

#: qubes_config/global_config.glade:1337
msgid ""
"This qube provides network access to all qubes using the default networking "
"setting."
msgstr ""
"ה-qube הזה מספק גישה לרשת לכל ה-qubes שמשתמשים בהגדרת הרשת שבברירת המחדל."

#: qubes_config/global_config.glade:1365
msgid "Default template:"
msgstr "תבנית ברירת מחדל:"

#: qubes_config/global_config.glade:1381
msgid ""
"Default template for new qubes. This setting has no effect on existing "
"qubes."
msgstr ""
"תבנית ברירת המחדל ל-qubes חדשים. ההגדרה הזו לא משפיעה על qubes קיימים."

#: qubes_config/global_config.glade:1404
msgid "Customize the appearance and behavior of windows and tray icons."
msgstr "התאמה אישית של המראה וההתנהגות של חלונות וסמלים במגש המערכת."

#: qubes_config/global_config.glade:1444
msgid ""
"Allowing qubes to use fullscreen mode can have unexpected security "
"consequences. <a href=\"https://www.qubes-os.org/doc/how-to-enter-"
"fullscreen-mode/\">Learn more.</a>"
msgstr ""
"מתן אפשרות ל-qubes להשתמש במצב מסך מלא עלול לגרום לבעיות אבטחה לא צפויות. <a"
" href=\"https://www.qubes-os.org/doc/how-to-enter-fullscreen-mode/\">מידע "
"נוסף.</a>"

#: qubes_config/global_config.glade:1473
msgid "UTF-8 window titles:"
msgstr "כותרות חלון ב-UTF-8:"

#: qubes_config/global_config.glade:1489
msgid ""
"\"Allow\" allows app qubes to display a wider range of characters in window "
"titles, but increases the attack surface."
msgstr ""
"\"אפשר\" מאפשר ל-qubes יישומים להציג מגוון רחב יותר של תווים בכותרות חלונות,"
" אבל מגדיל את שטח התקיפה."

#: qubes_config/global_config.glade:1510 qubes_config/global_config.glade:1522
#: qubes_config/global_config.glade:1534 qubes_config/global_config.glade:1546
#: qubes_config/global_config.glade:1788 qubes_config/global_config.glade:2034
#: qubes_config/global_config.glade:3046 qubes_config/global_config.glade:3293
#: qubes_config/global_config.glade:3543 qubes_config/global_config.glade:3857
#: qubes_config/global_config.glade:4191 qubes_config/global_config.glade:4543
#: qubes_config/global_config.glade:4907 qubes_config/global_config.glade:5262
#: qubes_config/global_config.glade:5548 qubes_config/global_config.glade:5790
#: qubes_config/global_config.glade:6307 qubes_config/global_config.glade:6899
#: qubes_config/global_config.glade:7022 qubes_config/global_config.glade:8514
msgid "anchor"
msgstr "עוגן"

#: qubes_config/global_config.glade:1560
msgid "General Settings"
msgstr "הגדרות כלליות"

#: qubes_config/global_config.glade:1576
msgid "Tray icon style:"
msgstr "סגנון סמלי מגש המערכת:"

#: qubes_config/global_config.glade:1591
msgid "Default Linux Kernel:"
msgstr "ליבת Linux ברירת מחדל:"

#: qubes_config/global_config.glade:1606
msgid "Minimum qube memory:"
msgstr "זיכרון מינימלי ל-qube:"

#: qubes_config/global_config.glade:1621
msgid "Additional dom0 memory:"
msgstr "זיכרון נוסף ל-dom0:"

#: qubes_config/global_config.glade:1655 qubes_config/global_config.glade:1695
#: qubes_config/global_config.glade:5716 qubes_config/new_qube.glade:1419
msgid "MiB"
msgstr "MiB"

#: qubes_config/global_config.glade:1753
msgid "General"
msgstr "כללי"

#: qubes_config/global_config.glade:1803
msgid "USB Input Devices"
msgstr "התקני קלט USB"

#: qubes_config/global_config.glade:1819
msgid ""
"USB input devices, especially keyboards, are a significant security risk. If"
" you're not using a USB keyboard, USB mouse, USB touchscreen, or USB tablet,"
" you can disable them here. (Note: Laptop built-in keyboards are usually not"
" USB keyboards.)"
msgstr ""
"התקני קלט USB, במיוחד מקלדות, הם סיכון אבטחה משמעותי. אם אינך משתמש במקלדת "
"USB, עכבר USB, מסך מגע USB או טאבלט USB, אפשר להשבית אותם כאן. (הערה: מקלדות"
" מובנות במחשבים ניידים הן בדרך כלל לא מקלדות USB.)"

#: qubes_config/global_config.glade:1841
#: qubes_config/global_config/usb_devices.py:242
msgid "Unexpected policy file contents:"
msgstr "תוכן לא צפוי בקובץ כללי ההרשאות:"

#: qubes_config/global_config.glade:1867 qubes_config/global_config.glade:2246
#: qubes_config/global_config.glade:4595 qubes_config/global_config.glade:5890
#: qubes_config/global_config.glade:6406 qubes_config/global_config.glade:7074
#: qubes_config/global_config.glade:7723 qubes_config/global_config.glade:8567
msgid ""
"Custom policy changes found. The changes below may be overwritten by "
"existing custom policy changes. View the files listed below to verify the "
"existing policy."
msgstr ""
"נמצאו שינויים מותאמים אישית בכללי ההרשאות. השינויים שלמטה עשויים להידרס על "
"ידי שינויים מותאמים אישית קיימים. יש לעיין בקבצים שברשימה למטה כדי לבדוק את "
"כללי ההרשאות הקיימים."

#: qubes_config/global_config.glade:1917
msgid "USB <b>qube</b>"
msgstr "<b>qube</b> USB"

#: qubes_config/global_config.glade:1934
msgid ""
"A USB qube is a qube to which one or more USB controllers are connected. "
msgstr "‏qube USB הוא qube שמחוברים אליו בקר USB אחד או יותר. "

#: qubes_config/global_config.glade:1958
msgid "<b>Keyboard</b>: "
msgstr "<b>מקלדת</b>: "

#: qubes_config/global_config.glade:1974
msgid "<b>Mouse</b>: "
msgstr "<b>עכבר</b>: "

#: qubes_config/global_config.glade:1990
msgid "<b>Touchscreen/Tablet</b>: "
msgstr "<b>מסך מגע/טאבלט</b>: "

#: qubes_config/global_config.glade:2049
msgid "U2F devices"
msgstr "התקני U2F"

#: qubes_config/global_config.glade:2066
msgid ""
"Qubes U2F Proxy allows you to use Universal 2nd Factor (U2F) two-factor authentication (2FA) devices without exposing the whole device and all of its contents to every qube. <a href=\"https://www.qubes-os.org/doc/u2f-proxy/\">Learn more.</a>\n"
"\n"
"<b>Note:</b> In order to use the U2F proxy in a qube, its template must have the <tt>qubes-u2f</tt> package installed. By default, a qube can use only keys that it has registered itself."
msgstr ""
"‏Qubes U2F Proxy מאפשר להשתמש בהתקני אימות דו-שלבי (2FA) מסוג Universal 2nd Factor (U2F) בלי לחשוף את כל ההתקן ואת כל התוכן שלו לכל qube. <a href=\"https://www.qubes-os.org/doc/u2f-proxy/\">מידע נוסף.</a>\n"
"\n"
"<b>הערה:</b> כדי להשתמש ב-U2F proxy ב-qube, יש להתקין את החבילה <tt>qubes-u2f</tt> בתבנית שלו. בברירת המחדל, qube יכול להשתמש רק במפתחות שהוא רשם בעצמו."

#: qubes_config/global_config.glade:2098
msgid "<b>USB qube</b>"
msgstr "<b>qube USB</b>"

#: qubes_config/global_config.glade:2114
msgid "Qube to which the USB controller is connected."
msgstr "ה-qube שאליו מחובר בקר ה-USB."

#: qubes_config/global_config.glade:2176
msgid ""
"Some policy rules could not be parsed. They are correct but are too "
"complicated for this tool to handle. They will be discarded on save. The "
"following rules were affected:"
msgstr ""
"לא ניתן היה לפענח חלק מכללי ההרשאות. הם תקינים, אבל מסובכים מדי לכלי הזה. הם"
" יימחקו בשמירה. הכללים שהושפעו:"

#: qubes_config/global_config.glade:2219
msgid ""
"The Qubes U2F Proxy service is not installed in the USB qube. If you wish to"
" use this service, install the <tt>qubes-u2f</tt> package in the template on"
" which the USB qube is based."
msgstr ""
"שירות Qubes U2F Proxy לא מותקן ב-qube ה-USB. כדי להשתמש בשירות, יש להתקין את"
" החבילה <tt>qubes-u2f</tt> בתבנית שעליה מבוסס ה-qube של ה-USB."

#: qubes_config/global_config.glade:2293
msgid "<b>Enable the Qubes U2F Proxy</b> service"
msgstr "<b>הפעלת השירות Qubes U2F Proxy</b>"

#: qubes_config/global_config.glade:2321
msgid "<b>List of qubes that can use the U2F Proxy:</b>"
msgstr "<b>רשימת ה-qubes שיכולים להשתמש ב-U2F Proxy:</b>"

#: qubes_config/global_config.glade:2436 qubes_config/global_config.glade:2717
#: qubes_config/global_config.glade:2952
msgid ""
"If you don't see the desired qube here, install the <tt>qubes-u2f</tt> "
"package in the template on which it is based (or, if it's a standalone, in "
"the qube itself)."
msgstr ""
"אם ה-qube הרצוי לא מופיע כאן, יש להתקין את החבילה <tt>qubes-u2f</tt> בתבנית "
"שעליה הוא מבוסס (או, אם הוא qube עצמאי, ב-qube עצמו)."

#: qubes_config/global_config.glade:2483
msgid "Enable <b>registering new keys</b> with the U2F Proxy service"
msgstr "הפעלת <b>רישום מפתחות חדשים</b> בשירות U2F Proxy"

#: qubes_config/global_config.glade:2516
msgid "<b>All qubes</b>"
msgstr "<b>כל ה-qubes</b>"

#: qubes_config/global_config.glade:2529
msgid "selected above can register new keys"
msgstr "שנבחרו למעלה יכולים לרשום מפתחות חדשים"

#: qubes_config/global_config.glade:2568
msgid "<b>Only selected qubes</b>"
msgstr "<b>רק qubes שנבחרו</b>"

#: qubes_config/global_config.glade:2581
msgid "can register new keys"
msgstr "יכולים לרשום מפתחות חדשים"

#: qubes_config/global_config.glade:2774
msgid "Allow some qubes to access <b>ALL</b> keys stored on your U2F device"
msgstr "לאפשר לחלק מה-qubes גישה ל<b>כל</b> המפתחות שבהתקן ה-U2F"

#: qubes_config/global_config.glade:2825
msgid ""
"Caution:\n"
"<b>All</b> keys, including those registered by other qubes and those registered previously, will be available to the qubes selected below."
msgstr ""
"זהירות:\n"
"<b>כל</b> המפתחות, כולל מפתחות שנרשמו על ידי qubes אחרים ומפתחות שנרשמו בעבר, יהיו זמינים ל-qubes שנבחרו למטה."

#: qubes_config/global_config.glade:3011
#: qubes_config/global_config/device_attachments.py:75
msgid "USB Devices"
msgstr "התקני USB"

#: qubes_config/global_config.glade:3061
msgid "Device Attachment Policy"
msgstr "כללי הרשאות לחיבור התקנים"

#: qubes_config/global_config.glade:3077
msgid ""
"You can block the ability to manually attach some (or all) device types or "
"devices to selected qubes. This does <b>not</b> apply to automatic "
"attachment set below."
msgstr ""
"אפשר לחסום את האפשרות לחבר ידנית חלק מסוגי ההתקנים או ההתקנים (או את כולם) "
"ל-qubes שנבחרו. זה <b>לא</b> חל על חיבור אוטומטי שמוגדר למטה."

#: qubes_config/global_config.glade:3100
msgid "No policy rules defined"
msgstr "לא הוגדרו כללי הרשאות"

#: qubes_config/global_config.glade:3152 qubes_config/global_config.glade:3402
#: qubes_config/global_config.glade:3649
msgid "Add new rule"
msgstr "הוספת כלל חדש"

#: qubes_config/global_config.glade:3206 qubes_config/global_config.glade:3456
#: qubes_config/global_config.glade:3703
msgid "Edit selected rule"
msgstr "עריכת הכלל שנבחר"

#: qubes_config/global_config.glade:3260 qubes_config/global_config.glade:3510
#: qubes_config/global_config.glade:3757
msgid "Remove selected rule"
msgstr "הסרת הכלל שנבחר"

#: qubes_config/global_config.glade:3308
msgid "Device Assignment"
msgstr "הקצאת התקנים"

#: qubes_config/global_config.glade:3324
msgid ""
"Devices can be assigned to selected qubes. The device will be attached as "
